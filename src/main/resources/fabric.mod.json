{
  "schemaVersion": 1,
  "id": "farmerscreate",
  "version": "${version}",
  "name": "Create Fly: Farmers Create",
  "description": "FarmersCreate port for Create Fly 26.1.2. Every Farmer's Delight cutting board recipe also runs on a deployer, and every cooking pot recipe in a heated mixer.",
  "authors": [
    "ChefExperte",
    "chaevsfe"
  ],
  "contributors": [
    "chaevsfe"
  ],
  "contact": {
    "homepage": "https://github.com/chaevsfe/FarmersCreate",
    "sources": "https://github.com/chaevsfe/FarmersCreate",
    "issues": "https://github.com/chaevsfe/FarmersCreate/issues",
    "upstream": "https://modrinth.com/mod/farmerscreate"
  },
  "license": "AGPL-3.0",
  "icon": "assets/farmerscreate/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.chefexperte.farmersCreate.FarmersCreate"
    ]
  },
  "mixins": [
    "farmers-create.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency_version}",
    "farmersdelight": "${farmers_delight_version_range}",
    "create": "${create_fabric_version_range}",
    "java": ">=25"
  }
}
